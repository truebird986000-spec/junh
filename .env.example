# Render가 자동으로 제공하는 PORT를 사용합니다. 로컬 실행 시에만 필요합니다.
PORT=3000

# 브라우저에 전달 가능한 Supabase 공개 연결 정보입니다.
# service_role, sb_secret_ 접두사 키, 데이터베이스 비밀번호는 절대 넣지 마세요.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_KEY

# 선택 사항: { temperature, humidity, condition, icon, message, mission } 형식의 JSON API URL
# 설정하지 않으면 앱은 교육용 샘플 날씨를 사용합니다.
WEATHER_API_URL=
